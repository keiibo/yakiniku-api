{
  "name": "yakiniku-api",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source Web API for yakiniku shops.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && wrangler deploy --dry-run --outdir dist",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
